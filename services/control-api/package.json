{
  "name": "@kelay/control-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-lambda": "^3.1166.0",
    "@aws-sdk/client-sfn": "^3.1166.0",
    "@aws-sdk/client-sqs": "^3.1166.0",
    "@hono/node-server": "^2.1.7",
    "@kelay/contracts": "workspace:*",
    "@kelay/tokens": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "aws-sdk-client-mock": "^4.1.0",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1"
  }
}
