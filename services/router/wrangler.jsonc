{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kelay-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Route table: key `app:<handle>/<app>` → {"prod"?:{"origin","region"?},"dev"?:{"origin","region"?}}
  // (AppRoute in @kelay/contracts). The control API writes an app's entry on every deploy and publish.
  // Replace the id with the namespace created by `wrangler kv namespace create ROUTES`.
  "kv_namespaces": [{ "binding": "ROUTES", "id": "00000000000000000000000000000000" }],
  // Local defaults (contract §11). Deployed environments override these.
  "vars": {
    "MCP_ORIGIN": "http://localhost:4004",
    "CONTROL_ORIGIN": "http://localhost:4003",
    "AWS_REGION": "ap-northeast-2"
  },
  // An IAM identity allowed only lambda:InvokeFunctionUrl on app functions. Set with
  // `wrangler secret put <NAME>`; for `wrangler dev`, copy .dev.vars.example to .dev.vars. Never commit values.
  "secrets": { "required": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"] },
  "dev": { "port": 8787 }
}
