# Values for the Secrets Manager secrets Terraform creates empty (`terraform output secret_arns`).
# Copy to secrets.<env>.env (ignored by git), fill in, then run infra/deploy/set-secrets.sh.
# One name=value per line; the value is everything after the first "=", with no quotes.
#
# ECS cannot start a task while any secret it references has no value, so give every secret a service
# uses a value before that service runs, even one you do not use yet (use the word "unused").
#
# The database logins are not in this file. Terraform writes them (kelay-<env>/db-platform and
# kelay-<env>/db-litellm) and the db-bootstrap task applies them to Postgres (docs/deploy.md, step 4).

# Signs caller tokens between services. At least 32 characters: openssl rand -base64 48
kelay-caller-secret=
# Encrypts Kelay ID's signing keys in the control DB. Changing it later invalidates them: openssl rand -base64 48
better-auth-secret=

# Sign-in providers: one pair for each provider listed in `identity_social_providers` of the env's
# terraform.tfvars. Terraform creates no secret for a provider that is not listed there.
# google-client-id=
# google-client-secret=
# kakao-client-id=
# kakao-client-secret=
# github-client-id=
# github-client-secret=

# LLM gateway (infra/litellm/README.md). The Control API calls the gateway with llm-gateway-key.
litellm-master-key=
litellm-salt-key=
llm-gateway-key=
anthropic-api-key=
openai-api-key=unused
gemini-api-key=unused

# Lets the Control API write the Router's route table (Workers KV). A Cloudflare API token with the
# permission "Workers KV Storage: Edit" on the env's account and no other. It is not the token Terraform uses.
cloudflare-kv-token=

# clickhouse-password is written by Terraform when enable_clickhouse = true, and no task reads it
# otherwise, so it never needs a value from this file.
