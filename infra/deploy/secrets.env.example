# Values for the Secrets Manager secrets Terraform creates empty (`terraform output secret_arns`).
# Copy to secrets.<env>.env (ignored by git), fill in, then run infra/deploy/set-secrets.sh.
# One name=value per line; the value is everything after the first "=", with no quotes.
#
# ECS cannot start a task while any secret it references has no value, so give every secret a service
# uses a value before that service runs, even one you do not use yet (use the word "unused").

# Signs caller tokens between services. At least 32 characters: openssl rand -base64 48
kelay-caller-secret=
# postgres://<user>:<password>@<db_proxy_endpoint>:5432/kelay_control?sslmode=require
# (terraform output db_proxy_endpoint; credentials from the secret in terraform output db_master_secret_arn)
control-database-url=
# Encrypts Kelay ID's signing keys in the control DB. Changing it later invalidates them: openssl rand -base64 48
better-auth-secret=

# OAuth client secrets of the sign-in providers. Kelay ID enables a provider only when its client id
# (GOOGLE_CLIENT_ID and so on, plain env) is set too.
google-client-secret=unused
kakao-client-secret=unused
github-client-secret=unused

# LLM gateway (infra/litellm/README.md). The Control API calls the gateway with llm-gateway-key.
litellm-master-key=
litellm-salt-key=
# postgres://<user>:<password>@<db_proxy_endpoint>:5432/litellm?sslmode=require
litellm-database-url=
llm-gateway-key=
anthropic-api-key=
openai-api-key=unused
gemini-api-key=unused

# Not read by any service yet; they need a value only because control-api's task definition lists them.
forgejo-token=unused
cloudflare-kv-token=unused

# clickhouse-password is written by Terraform when enable_clickhouse = true. Set it here only when
# ClickHouse is off and the otel-collector service runs.
# clickhouse-password=unused
