# Data source for the console: mock (fixtures, no backend) or http (Control API).
CONSOLE_DATA=mock
# Used when CONSOLE_DATA=http. Calls carry the builder token from the kelay_token cookie.
CONTROL_API_URL=http://localhost:4003
# Origin public app links are built from (/<handle>/<app>), and the MCP gateway's public base URL.
KELAY_APP_ORIGIN=https://kelay.app
MCP_PUBLIC_BASE_URL=http://localhost:4004
# The Builder (services/builder). Unset: apps have no workspace, dev preview or chat.
BUILDER_URL=http://localhost:4006
