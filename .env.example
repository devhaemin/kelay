# Local development defaults. `pnpm dev:up` works without a .env; copy this file to .env to change a value.
CONTROL_DATABASE_URL=postgres://kelay:kelay@localhost:54320/kelay_control
KELAY_ID_ISSUER=http://localhost:4001
KELAY_ID_JWKS_URL=http://localhost:4001/api/auth/jwks
# Encrypts Kelay ID's signing keys in the control DB. The seed and the service must use the same value.
BETTER_AUTH_SECRET=kelay-identity-dev-secret-not-for-production
KELAY_CALLER_SECRET=dev-caller-secret-change-me-32-bytes-min
KELAY_APPS_FILE=packages/contracts/fixtures/apps.local.json
DATA_API_URL=http://localhost:4002
CONTROL_API_URL=http://localhost:4003
MCP_PUBLIC_BASE_URL=http://localhost:4004
# The run orchestrator. Its local driver loads agent nodes from RUNNER_LOCAL_NODES (<app>=<module>, comma-separated);
# the default is Ticket Board's nodes in examples/ticket-board-nodes. One user may have this many runs in progress.
RUNNER_URL=http://localhost:4007
# RUNNER_LOCAL_NODES=ticket-board=examples/ticket-board-nodes/src/index.ts
# RUNNER_MAX_CONCURRENT_RUNS_PER_USER=2
# The console (CONSOLE_DATA=http under `pnpm dev:up`) and the local sign-in helper that sets its cookie.
CONSOLE_URL=http://localhost:3000
DEV_LOGIN_URL=http://localhost:4005
# Database URL of an app env that has none yet; the Control API applies access rules there on deploy.
# Placeholders: {app} (dashes become underscores) and {env}. Unset by default: the seed sets Ticket Board's database itself.
# APP_DATABASE_URL_TEMPLATE=postgres://kelay:kelay@localhost:54320/app_{app}_{env}
# Origin public app links are built from. The router that serves it is not part of `pnpm dev:up`.
KELAY_APP_ORIGIN=http://localhost:8787
# Feedback triage, reports and agent nodes call the model through the LLM gateway. With ANTHROPIC_API_KEY set,
# `pnpm dev:up` starts LiteLLM on port 4000 and points the services at it. Without it there is no gateway, and
# those calls fail with "LLM gateway not configured". Set LLM_GATEWAY_URL only to use a gateway that runs elsewhere.
ANTHROPIC_API_KEY=
# LLM_GATEWAY_URL=http://localhost:4000
LLM_GATEWAY_KEY=sk-kelay-dev
# Kelay ID. Origins besides its own whose pages may call POST /v1/token with the session cookie (comma-separated).
KELAY_ID_CORS_ORIGINS=http://localhost:3000
# Header Kelay ID reads the client IP from for its rate limits. Leave unset locally. A production build
# defaults to cf-connecting-ip (Cloudflare in front of an ALB that only Cloudflare can reach); set it to
# another single-value header only if a different edge fronts the service.
# KELAY_ID_CLIENT_IP_HEADER=cf-connecting-ip
