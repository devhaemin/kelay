{
  "name": "kelay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.scripts.json",
    "build": "pnpm -r --if-present build",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "dev:up": "tsx scripts/dev-up.ts",
    "dev:down": "tsx scripts/dev-down.ts",
    "dev:login": "tsx scripts/dev-login.ts",
    "seed": "tsx scripts/seed.ts",
    "e2e": "vitest run --config e2e/vitest.config.ts"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.7",
    "@kelay/contracts": "workspace:*",
    "@kelay/control-api": "workspace:*",
    "@kelay/identity": "workspace:*",
    "@kelay/policy": "workspace:*",
    "@kelay/runtime": "workspace:*",
    "@kelay/sdk": "workspace:*",
    "@kelay/ticket-board-nodes": "workspace:*",
    "@kelay/tokens": "workspace:*",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/wait-on": "^5.3.4",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "execa": "^10.2.1",
    "oauth4webapi": "^3.8.8",
    "pg": "^8.23.1",
    "tough-cookie": "^6.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
